# Required: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=
# Optional retired keys for rotation (comma-separated or JSON array). New writes use FERNET_KEY;
# decrypt tries primary then previous. Keep old keys until all stored results are re-encrypted.
# FERNET_PREVIOUS_KEYS=
# Optional JSONL mirror of audit events (SQLite audit_events is always on via STATE_DB_PATH).
# AUDIT_LOG_PATH=logs/audit.jsonl
# AUDIT_LOG_MAX_EVENTS=10000

# Required by default. Use a long random value (for example: `openssl rand -hex 32`).
API_AUTH_TOKEN=
# Optional additional tokens (comma-separated or JSON array). Full admin access each.
# API_AUTH_TOKENS=operator-a-token,operator-b-token
# Optional named keys with scopes (JSON array). Scopes: read, scan, admin (admin > scan > read).
# API_AUTH_KEYS=[{"id":"reader","label":"Read only","token":"...","scopes":["read"]},{"id":"ops","label":"Scanner","token":"...","scopes":["scan"]}]
API_AUTH_REQUIRED=true
API_AUTH_HEADER=X-API-KEY

# Network and workload limits
APP_HOST=127.0.0.1
APP_PORT=5000
# When true, GET /metrics requires X-API-KEY with read scope (recommended if not loopback-only).
# METRICS_AUTH_REQUIRED=false
# When true, logs are single-line JSON (includes job_id when provided).
# STRUCTURED_LOGS=false
# Optional expected service posture for drift checks (JSON or file).
# EXPECTED_POSTURE={"deny_unexpected":true,"services":[{"port":22,"proto":"tcp","name":"ssh"}]}
# EXPECTED_POSTURE_FILE=/path/to/posture.json
MAX_CONCURRENT_SCANS=2
MAX_SCHEDULED_TASKS=100
MAX_SCAN_JOBS=200
MAX_REQUESTS_PER_WINDOW=10
MAX_RATE_LIMIT_CLIENTS=10000
RATE_LIMIT_WINDOW_SECONDS=60
# Optional shared rate limits for multi-worker deploys (empty = in-process memory).
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_RATE_LIMIT_PREFIX=recon_operator:rl:
# Include API-key owner hash in rate-limit buckets (recommended multi-token).
RATE_LIMIT_INCLUDE_OWNER=true
# Trusted reverse-proxy mode (opt-in). When true, rate-limit client IP may come from
# X-Forwarded-For / X-Real-IP only if the direct peer is listed in TRUSTED_PROXIES.
# TRUSTED_PROXY_MODE=false
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# Multi-worker job leases (SQLite claim; Redis fence when REDIS_URL is set).
# WORKER_ID=worker-1
JOB_LEASE_SECONDS=90
JOB_CLAIM_POLL_SECONDS=2
# REDIS_JOB_LEASE_PREFIX=recon_operator:job_lease:
# Scheduler multi-instance: only the leader runs recurring scans.
SCHEDULER_LEADER_SECONDS=30
SCHEDULER_LEADER_POLL_SECONDS=5
# REDIS_LEADER_PREFIX=recon_operator:leader:
MAX_REQUEST_BODY_BYTES=1048576
MAX_TARGET_ADDRESSES=4096
# Optional engagement scope. Empty = unrestricted (server logs a startup WARNING;
# /health reports target_allowlist_restricted=false). Set in production.
# TARGET_ALLOWLIST=127.0.0.1,10.0.0.0/8,lab.example.com,*.corp.internal
# TARGET_ALLOWLIST_FILE=/path/to/allowlist.txt
MIN_SCHEDULE_INTERVAL_MINUTES=1
MAX_SCHEDULE_INTERVAL_MINUTES=10080
SCAN_TIMEOUT_SECONDS=1800
NMAP_HOST_TIMEOUT_SEC=300
NMAP_MAX_RETRIES=2

# Persistence and optional integrations
RESULTS_DIR=encrypted_results
RESULTS_MAX_FILES=500
RESULTS_MAX_AGE_DAYS=0
# When false, pre-1.7 result files without an owner prefix are hidden (secure default).
LEGACY_RESULTS_SHARED=false
# When false, pre-1.7 job/task rows without an owner are hidden and not cancellable (secure default).
LEGACY_JOBS_SHARED=false
MAX_IMPORT_XML_BYTES=16777216
STATE_DB_PATH=data/recon_operator.db
AI_REPORTS_MAX_DIRS=100
AI_REPORTS_MAX_AGE_DAYS=0
SCAN_LOG_PATH=logs/scan_log.txt
TOOL_INVENTORY_CACHE_SECONDS=300
# When true, Telegram notifications include the scan target. Default false:
# notification channels are often more broadly observable than the operator UI.
TELEGRAM_INCLUDE_TARGET=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INITIAL_TASKS=[]
